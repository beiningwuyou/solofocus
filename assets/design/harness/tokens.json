{
  "$meta": {
    "name": "PGT Workbench Design Tokens",
    "version": "1.0.0",
    "updated": "2026-08-06",
    "source": "reverse-extracted from src/client/styles.css @ 2026-08-06",
    "notice": "唯一事实源。改完必须跑 node scripts/tokens-build.mjs。禁止直接编辑 tokens.generated.css。",
    "namingRule": "cssVar 字段是权威的变量名，必须与现有代码保持一致。新增 token 时命名向现有体系看齐，不要为了优雅而重命名——那会打断上千处调用。重命名属于 P5 债务偿还范畴，需单独规划。"
  },

  "color": {
    "brand": {
      "navy":        { "cssVar": "--navy",        "light": "#112c54", "dark": "#93b4f5", "usage": "品牌锚点、侧栏选中态、主按钮底色" },
      "navyStrong":  { "cssVar": "--navy-strong", "light": "#092650", "dark": "#b8cff8", "usage": "navy 加深态，用于 hover/active" }
    },
    "semantic": {
      "blue":   { "cssVar": "--blue",   "light": "#2563eb", "dark": "#60a5fa", "usage": "信息、链接、进行中、焦点环" },
      "green":  { "cssVar": "--green",  "light": "#16a34a", "dark": "#16a34a", "usage": "成功、已完成、正向指标" },
      "orange": { "cssVar": "--orange", "light": "#f97316", "dark": "#f97316", "usage": "警告、临近截止、需关注" },
      "violet": { "cssVar": "--violet", "light": "#7c3aed", "dark": "#a78bfa", "usage": "AI 相关功能专属标识" },
      "red":    { "cssVar": "--red",    "light": "#ef4444", "dark": "#ef4444", "usage": "错误、逾期、破坏性操作" }
    },
    "aiSurface": {
      "violetSoft":   { "cssVar": "--violet-soft",   "light": "#f5f3ff", "dark": "#2a1d52", "usage": "AI 区块浅底" },
      "violetBorder": { "cssVar": "--violet-border", "light": "#ddd6fe", "dark": "#4c3a8a", "usage": "AI 区块边框" },
      "violetDeep":   { "cssVar": "--violet-deep",   "light": "#6d28d9", "dark": "#a78bfa", "usage": "AI 区块强调文字" }
    },
    "text": {
      "primary":   { "cssVar": "--text",           "light": "#13213a", "dark": "#e2e8f0", "usage": "正文主色。刻意非纯黑，降低长时间阅读疲劳" },
      "secondary": { "cssVar": "--text-secondary", "light": "#475569", "dark": "#94a3b8", "usage": "次级信息、说明文字" },
      "muted":     { "cssVar": "--muted",          "light": "#718096", "dark": "#64748b", "usage": "弱化信息、表头、时间戳" },
      "mutedLight":{ "cssVar": "--muted-light",    "light": "#94a3b8", "dark": "#475569", "usage": "占位符、禁用态" }
    },
    "surface": {
      "background":  { "cssVar": "--app-bg",       "light": "#ffffff", "dark": "#0f172a", "usage": "页面底色。亮色为真白，不用灰白打底" },
      "soft":        { "cssVar": "--soft",         "light": "#f7f9fc", "dark": "#1e293b", "usage": "面板/侧栏/表头浅底" },
      "softHover":   { "cssVar": "--soft-hover",   "light": "#f0f3f8", "dark": "#25344a", "usage": "行 hover 态" },
      "border":      { "cssVar": "--border",       "light": "#e3e8f0", "dark": "#334155", "usage": "主分隔线。层次的主要建立手段" },
      "borderLight": { "cssVar": "--border-light", "light": "#edf0f4", "dark": "#2d3a4d", "usage": "弱分隔线" }
    }
  },

  "radius": {
    "sm":      { "cssVar": "--radius-sm", "value": "6px",  "usage": "小控件：标签、徽章" },
    "default": { "cssVar": "--radius",    "value": "9px",  "usage": "默认控件：按钮、输入框" },
    "lg":      { "cssVar": "--radius-lg", "value": "11px", "usage": "面板、卡片" },
    "xl":      { "cssVar": "--radius-xl", "value": "14px", "usage": "浮层：modal、大容器" },
    "pill":    { "cssVar": "--radius-pill", "value": "9999px", "usage": "全圆角胶囊（品牌 CTA 语法，Apple/Claude/ElevenLabs 用）" },
    "full":    { "cssVar": "--radius-full", "value": "9999px", "usage": "正圆：头像、icon 按钮" }
  },

  "shadow": {
    "xs":      { "cssVar": "--shadow-xs", "light": "0 1px 3px rgba(17, 44, 84, .04)",  "dark": "0 1px 3px rgba(0, 0, 0, .2)",  "usage": "极轻微抬升" },
    "default": { "cssVar": "--shadow",    "light": "0 4px 16px rgba(17, 44, 84, .05)", "dark": "0 4px 16px rgba(0, 0, 0, .25)", "usage": "面板默认阴影" },
    "md":      { "cssVar": "--shadow-md", "light": "0 8px 28px rgba(17, 44, 84, .08)", "dark": "0 8px 28px rgba(0, 0, 0, .35)", "usage": "浮层：dropdown、modal" }
  },

  "space": {
    "xs":      { "cssVar": "--gap-xs", "value": "6px",  "usage": "紧密元素间：图标与文字" },
    "default": { "cssVar": "--gap",    "value": "10px", "usage": "默认间距。2026-08-06 修复自引用 bug 后恢复可用" },
    "md":      { "cssVar": "--gap-md", "value": "16px", "usage": "组件间距" },
    "lg":      { "cssVar": "--gap-lg", "value": "22px", "usage": "区块间距" },
    "xl":      { "cssVar": "--gap-xl", "value": "28px", "usage": "大区块分隔" }
  },

  "layout": {
    "contentPx":    { "cssVar": "--content-px",    "value": "24px",  "usage": "内容区左右内边距" },
    "contentPy":    { "cssVar": "--content-py",    "value": "22px",  "usage": "内容区上下内边距" },
    "sidebarWidth": { "cssVar": "--sidebar-width", "value": "230px", "usage": "桌面侧栏宽度" },
    "topbarHeight": { "cssVar": "--topbar-height", "value": "78px",  "usage": "顶栏高度" }
  },

  "fontSize": {
    "xs":   { "cssVar": "--text-xs",   "value": "11px", "usage": "元信息、时间戳、表头" },
    "sm":   { "cssVar": "--text-sm",   "value": "13px", "usage": "次级文字、表格内容" },
    "base": { "cssVar": "--text-base", "value": "14px", "usage": "正文基准。刻意小于常规 Web，服务高信息密度" },
    "lg":   { "cssVar": "--text-lg",   "value": "16px", "usage": "小标题" },
    "xl":   { "cssVar": "--text-xl",   "value": "20px", "usage": "区块标题" },
    "2xl":  { "cssVar": "--text-2xl",  "value": "26px", "usage": "页面标题" },
    "3xl":  { "cssVar": "--text-3xl",  "value": "32px", "usage": "关键数值展示" }
  },

  "fontWeight": {
    "$note": "只允许这四档。代码中现存 74 处非标准字重（520/560/620/650/680/720/760 等）属于历史债务，见 antipatterns.md。Inter 未本地加载，实际渲染回落到 PingFang SC，非标准字重多数无效。",
    "regular":  { "cssVar": "--weight-regular",  "value": "400", "usage": "正文" },
    "medium":   { "cssVar": "--weight-medium",   "value": "500", "usage": "次级强调、按钮文字" },
    "semibold": { "cssVar": "--weight-semibold", "value": "600", "usage": "标题、强调数值" },
    "bold":     { "cssVar": "--weight-bold",     "value": "700", "usage": "仅最高层级标题。慎用" }
  },

  "leading": {
    "heading": { "cssVar": "--leading-heading", "value": "1.2", "usage": "标题行高" },
    "tight":   { "cssVar": "--leading-tight",   "value": "1.3", "usage": "紧凑文本" },
    "normal":  { "cssVar": "--leading",         "value": "1.5", "usage": "正文行高" }
  },

  "motion": {
    "fast":   { "cssVar": "--transition-fast",   "value": "0.15s ease", "usage": "hover、focus 即时反馈" },
    "normal": { "cssVar": "--transition-normal", "value": "0.2s ease",  "usage": "展开/收起" },
    "slow":   { "cssVar": "--transition-slow",   "value": "0.28s ease", "usage": "页面淡入。时长上限，不得超过" }
  },

  "fontFamily": {
    "sans":   { "cssVar": "--font-sans",   "value": "Inter, \"PingFang SC\", \"Microsoft YaHei\", system-ui, -apple-system, sans-serif", "usage": "全局正文/UI 字体栈" },
    "display":{ "cssVar": "--font-display", "value": "Inter, \"PingFang SC\", system-ui, -apple-system, sans-serif", "usage": "标题/展示字族。主题可覆盖为 SF Pro Display / Copernicus / Waldenburg / Forma 等" },
    "body":   { "cssVar": "--font-body",   "value": "Inter, \"PingFang SC\", system-ui, -apple-system, sans-serif", "usage": "正文字族。主题可覆盖为 SF Pro Text / StyreneB / Times 等" },
    "mono":   { "cssVar": "--font-mono",   "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "usage": "代码/等宽字族。Claude/ElevenLabs 等品牌可覆盖为 JetBrains Mono" }
  },

  "breakpoint": {
    "$note": "断点不生成 CSS 变量（媒体查询不支持 var()），仅作规范记录供人和 AI 参考。",
    "mobile": { "value": "520px", "usage": "小屏断点" },
    "tablet": { "value": "800px", "usage": "侧栏折叠为底部导航的临界点" }
  }
}
