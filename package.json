{
  "name": "personal-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:tauri": "concurrently -k -n api,tauri -c blue,yellow \"tsx src/server/index.ts\" \"tauri dev\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "build:tauri": "pnpm build && pnpm prepare:runtime && tauri build",
    "bundle:server": "mkdir -p dist-server-bundle && node_modules/.pnpm/node_modules/esbuild/bin/esbuild dist-server/server/index.js --bundle --platform=node --format=cjs --target=node20 --packages=bundle --outfile=dist-server-bundle/server.cjs",
    "start": "node dist-server/server/index.js",
    "migrate:four-level": "tsx scripts/migrate-four-level-model.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "tokens": "node scripts/tokens-build.mjs",
    "tokens:all": "node scripts/tokens-build.mjs --all",
    "pretypecheck": "node scripts/tokens-build.mjs --all",
    "prebuild": "node scripts/tokens-build.mjs --all",
    "design:lint": "node scripts/design-lint.mjs",
    "design:baseline": "node scripts/design-lint.mjs --update-baseline",
    "check": "pnpm typecheck && pnpm design:lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@fastify/cors": "^11.3.0",
    "@tanstack/react-query": "^5.83.0",
    "@tauri-apps/api": "^2.11.1",
    "chokidar": "^4.0.3",
    "dompurify": "^3.4.12",
    "fastify": "^5.4.0",
    "imapflow": "^2.0.2",
    "lucide-react": "^0.536.0",
    "mailparser": "^3.9.26",
    "marked": "^18.0.7",
    "minisearch": "^7.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.6",
    "concurrently": "^9.2.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
