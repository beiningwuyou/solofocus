{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "个人工作台",
  "version": "1.0.0",
  "identifier": "com.pgt.workbench",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "个人工作台",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 14 },
        "resizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true,
      "tooltip": "个人工作台"
    },
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:4317; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../node-runtime/node", "../runtime", "../dist"],
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "copyright": "Copyright © 2026 zzx",
    "category": "Productivity",
    "shortDescription": "本地优先的个人工作台",
    "longDescription": "基于 Obsidian Vault 的个人目标、计划与行动工作台。本地优先。"
  }
}
